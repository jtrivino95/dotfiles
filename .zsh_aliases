alias tp=trash
alias g='agy'
alias gedit='gnome-text-editor'
alias aptup='sudo apt update && sudo apt upgrade'
alias k='kubectl'
alias kx='kubectx'
alias kn='kubens'
alias z='zshz -c 2>&1'
alias ag='ansible-galaxy'
alias ap='ansible-playbook'
alias ai='ansible-inventory'
alias upgrade_k9s='wget https://github.com/derailed/k9s/releases/latest/download/k9s_linux_amd64.deb && sudo apt install ./k9s_linux_amd64.deb && rm k9s_linux_amd64.deb'
alias genpasswd="tr -dc 'A-Za-z0-9!?%=' < /dev/urandom | head -c 10"
alias netskope-start='sudo systemctl start stagentd.service && systemctl --user start stagentapp.service'
alias netskope-stop='systemctl --user stop stagentapp.service && sudo systemctl stop stagentd.service'
alias forti-start='sudo systemctl start forticlient.service'
alias forti-stop='sudo systemctl stop forticlient.service'
alias bastion='f() { ssh -i ~/.ssh/$1-bastion-key ec2-user@bastion.$1.indramind-openshift.internal }; f'

